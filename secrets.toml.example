# ============================================================
# 这是 Streamlit Cloud 部署用的「密钥模板」。
# 使用方法：
#   1. 把这个文件复制一份，改名为 secrets.toml（注意：不要直接改这个 .example 文件）
#   2. 填入你的真实 API Key
#   3. 部署到 Streamlit Cloud 时，在应用的 Settings → Secrets 里粘贴相同内容
#
# ⚠️ 安全提醒：
#   - secrets.toml 已被 .gitignore 排除，绝不会被提交到 GitHub
#   - 任何能访问你部署网址的人，都会消耗这个 Key 的额度
#   - 建议只在需要分享时部署，或设置用量上限
# ============================================================

provider = "deepseek"
api_key = "sk-在这里填入你的真实密钥"
model = "deepseek-chat"
base_url = ""
